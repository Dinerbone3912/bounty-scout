+
 import json
 import sys
 from collections.abc import AsyncGenerator, Iterator, Mapping
@@ -116,7 +118,9 @@ class HTTPConnection(Mapping[str, Any], Generic[StateT]):
     @property
     def base_url(self) -> URL:
         if not hasattr(self, "_base_url"):
-            base_url_scope = dict(self.scope)
+            # Preserve the external authority advertised by a reverse proxy via the
+            # RFC 7239 ``Forwarded`` header (falls back to scope when absent).
+            base_url_scope = apply_forwarded(dict(self.scope))
             # This is used by request.url_for, it might be used inside a Mount which
             # would have its own child scope with its own root_path, but the base URL
             # for url_for should still be the top level app root path.
diff --git a/tests/test_forwarded.py b/tests/test_forwarded.py
new file mode 100644
index 0000000..28ff9de
--- /dev/null
+++ b/tests/test_forwarded.py
@@ -0,0 +1,108 @@
+import pytest
+
+from starlette._forwarded import apply_forwarded, parse_forwarded
+from starlette.requests import Request
+
+
+def make_scope(headers=None, server=("127.0.0.1", 8000), scheme="http"):
+    return {
+        "type": "http",
+        "method": "GET",
+        "path": "/sub/page",
+        "root_path": "/sub",
+        "scheme": scheme,
+        "server": server,
+        "headers": headers or [],
+    }
+
+
+class TestParseForwarded:
+    def test_missing_header(self):
+        assert parse_forwarded(None) == {}
+        assert parse_forwarded("") == {}
+
+    def test_simple_host_proto(self):
+        assert parse_forwarded("proto=https;host=edge.example.org") == {
+            "host": "edge.example.org",
+            "proto": "https",
+        }
+
+    def test_with_for_param(self):
+        got = parse_forwarded("for=192.0.2.43;proto=https;host=edge.example.org")
+        assert got == {"host": "edge.example.org", "proto": "https"}
+
+    def test_proto_uppercase_lowered(self):
+        assert parse_forwarded("proto=HTTPS;host=a.example.org")["proto"] == "https"
+
+    def test_first_element_wins(self):
+        got = parse_forwarded("host=edge.example.org;proto=https, host=internal:8080;proto=http")
+        assert got == {"host": "edge.example.org", "proto": "https"}
+
+    def test_quoted_value_with_comma(self):
+        got = parse_forwarded('host="edge.example.org";proto=https')
+        assert got["host"] == "edge.example.org"
+
+    def test_no_relevant_params(self):
+        assert parse_forwarded("for=192.0.2.43") == {}
+
+
+class TestApplyForwarded:
+    def test_absent_header_returns_same_scope(self):
+        scope = make_scope()
+        assert apply_forwarded(scope) is scope
+
+    def test_overrides_scheme_and_server(self):
+        scope = make_scope(headers=[(b"forwarded", b"proto=https;host=edge.example.org")])
+        out = apply_forwarded(scope)
+        assert out["scheme"] == "https"
+        assert out["server"] == ("edge.example.org", 443)
+
+    def test_explicit_port_preserved(self):
+        scope = make_scope(headers=[(b"forwarded", b"proto=https;host=edge.example.org:8443")])
+        out = apply_forwarded(scope)
+        assert out["server"] == ("edge.example.org", 8443)
+
+    def test_ipv6_host(self):
+        scope = make_scope(headers=[(b"forwarded", b'proto=https;host="[2001:db8::1]:443"')])
+        out = apply_forwarded(scope)
+        assert out["server"] == ("2001:db8::1", 443)
+
+    def test_http_default_port(self):
+        scope = make_scope(headers=[(b"forwarded", b"proto=http;host=public.example.org")])
+        out = apply_forwarded(scope)
+        assert out["server"] == ("public.example.org", 80)
+
+    def test_case_insensitive_header_name(self):
+        scope = make_scope(headers=[(b"Forwarded", b"proto=https;host=edge.example.org")])
+        out = apply_forwarded(scope)
+        assert out["scheme"] == "https"
+
+
+class TestRequestBaseUrl:
+    def test_base_url_uses_forwarded_authority(self):
+        scope = make_scope(
+            headers=[(b"forwarded", b"proto=https;host=edge.example.org")],
+            server=("127.0.0.1", 8000),
+        )
+        request = Request(scope)
+        assert str(request.base_url) == "https://edge.example.org/sub/"
+
+    def test_base_url_without_forwarded_unchanged(self):
+        scope = make_scope(server=("127.0.0.1", 8000), scheme="http")
+        request = Request(scope)
+        assert str(request.base_url) == "http://127.0.0.1:8000/sub/"
+
+    def test_url_for_uses_forwarded_authority(self):
+        from starlette.routing import Route
+
+        async def endpoint(request):
+            return None
+
+        route = Route("/page", endpoint, name="subpage")
+        scope = make_scope(
+            headers=[(b"forwarded", b"proto=https;host=edge.example.org")],
+            server=("127.0.0.1", 8000),
+        )
+        request = Request(scope)
+        request.scope["router"] = type("R", (), {"url_path_for": lambda self, name, **kw: route.url_path_for(name, **kw)})()
+        assert str(request.url_for("subpage")) == "https://edge.example.org/sub/page"
