diff --git a/starlette/_forwarded.py b/starlette/_forwarded.py
new file mode 100644
index 0000000..31b59e8
--- /dev/null
+++ b/starlette/_forwarded.py
@@ -0,0 +1,135 @@
+"""RFC 7239 ``Forwarded`` header parsing for ASGI request scope normalization.
+
+Reverse proxies commonly emit a ``Forwarded`` header describing the original
+client-facing request, e.g.::
+
+    Forwarded: for=192.0.2.43;proto=https;host=edge.example.org
+
+Starlette's :meth:`Request.base_url` (and therefore ``Request.url_for``) only
+consults ``scope['server']`` / ``scope['scheme']``. Behind a proxy that does not
+rewrite the ASGI scope, this raises the *internal* authority in generated
+absolute URLs instead of the *external* one the client actually used.
+
+This module normalizes the ``Forwarded`` header into a dict that can be merged
+onto a copy of the scope before the ``URL`` is built. It is a pure function so it
+can be unit-tested without a running server and degrades to a no-op when the
+header is absent (backward compatibility).
+"""
+
+from __future__ import annotations
+
+from typing import Any
+
+__all__ = ["parse_forwarded", "apply_forwarded"]
+
+
+def _split_forwarded_elements(value: str) -> list[str]:
+    elements: list[str] = []
+    buf: list[str] = []
+    in_quotes = False
+    i = 0
+    n = len(value)
+    while i < n:
+        ch = value[i]
+        if ch == '"':
+            if in_quotes and i + 1 < n and value[i + 1] == '"':
+                buf.append('""')
+                i += 2
+                continue
+            in_quotes = not in_quotes
+            buf.append(ch)
+        elif ch == "," and not in_quotes:
+            elements.append("".join(buf))
+            buf = []
+        else:
+            buf.append(ch)
+        i += 1
+    if "".join(buf).strip():
+        elements.append("".join(buf))
+    return [e.strip() for e in elements if e.strip()]
+
+
+def _parse_pairs(element: str) -> dict[str, str]:
+    pairs: dict[str, str] = {}
+    buf: list[str] = []
+    in_quotes = False
+    params: list[str] = []
+    for ch in element:
+        if ch == '"':
+            in_quotes = not in_quotes
+            buf.append(ch)
+        elif ch == ";" and not in_quotes:
+            params.append("".join(buf))
+            buf = []
+        else:
+            buf.append(ch)
+    if buf:
+        params.append("".join(buf))
+    for param in params:
+        if "=" not in param:
+            continue
+        key, _, val = param.partition("=")
+        key = key.strip().lower()
+        val = val.strip()
+        if len(val) >= 2 and val[0] == '"' and val[-1] == '"':
+            val = val[1:-1].replace('""', '"')
+        if key:
+            pairs[key] = val
+    return pairs
+
+
+def parse_forwarded(value: str | None) -> dict[str, str]:
+    """Return the first Forwarded element's ``host``/``proto`` (lowercased keys)."""
+    if not value:
+        return {}
+    for element in _split_forwarded_elements(value):
+        pairs = _parse_pairs(element)
+        out: dict[str, str] = {}
+        if pairs.get("host"):
+            out["host"] = pairs["host"]
+        if pairs.get("proto"):
+            out["proto"] = pairs["proto"].lower()
+        if out:
+            return out
+    return {}
+
+
+def _host_and_port(host: str) -> tuple[str, int | None]:
+    if host.startswith("["):
+        end = host.find("]")
+        if end != -1:
+            name = host[1:end]
+            rest = host[end + 1 :]
+            if rest.startswith(":") and rest[1:].isdigit():
+                return name, int(rest[1:])
+            return name, None
+    if ":" in host:
+        name, _, port = host.rpartition(":")
+        if port.isdigit():
+            return name, int(port)
+    return host, None
+
+
+def apply_forwarded(scope: dict[str, Any]) -> dict[str, Any]:
+    """Return a copy of ``scope`` with ``scheme``/``server`` updated from Forwarded."""
+    headers = scope.get("headers") or []
+    raw: str | None = None
+    for name, val in headers:
+        try:
+            lname = name.decode("latin-1").lower() if isinstance(name, (bytes, bytearray)) else str(name).lower()
+        except Exception:  # pragma: no cover
+            continue
+        if lname == "forwarded":
+            raw = val.decode("latin-1") if isinstance(val, (bytes, bytearray)) else str(val)
+            break
+    fwd = parse_forwarded(raw)
+    if not fwd:
+        return scope
+    new_scope = dict(scope)
+    if "proto" in fwd:
+        new_scope["scheme"] = fwd["proto"]
+    if "host" in fwd:
+        name, port = _host_and_port(fwd["host"])
+        default_port = 443 if new_scope.get("scheme") == "https" else 80
+        new_scope["server"] = (name, port if port is not None else default_port)
+    return new_scope
